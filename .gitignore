# -- runtime artifacts: never in git (huge / regenerable / machine-local) --
venv
data/
outputs/
logs/
*.log

# raw eval outputs are large; versioned summaries+comparisons ARE tracked
results/*/*/raw/
results/*/*/logs/

# tooling / local state
.claude/
__pycache__/
*.pyc
.ipynb_checkpoints/

# gateway secrets & logs & downloaded binaries
gateway/.env
gateway/logs/
gateway/bin/

# Keural Orbit is a SEPARATE project (Gemma 4) with its own repo — never in this one
Keural Orbit/

# model weights / large binaries never belong in git
*.safetensors
*.bin
*.pt
test model/logs/
